def solve(b, r, n):
    if r == n:
        return True
    for c in range(n):
        if all(b[i] != c and abs(b[i]-c) != r-i for i in range(r)):
            b[r] = c
            if solve(b, r+1, n):
                return True
    return False

n = int(input("Enter N: "))
b = [-1] * n

if solve(b, 0, n):
    for r in range(n):
        print(" ".join("Q" if b[r] == c else "." for c in range(n)))
else:
    print("No solution")
