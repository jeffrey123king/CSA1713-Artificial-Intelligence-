n = int(input("Enter number of cities: "))
d = []

for i in range(n):
    d.append(list(map(int, input(
        f"Enter distances for city {i}: ").split())))

start = int(input("Enter starting city (0 to n-1): "))
visited = [False] * n
visited[start] = True
tour = [start]
cost = 0
cur = start

while len(tour) < n:
    nxt = -1
    best = float('inf')

    for j in range(n):
        if not visited[j] and d[cur][j] < best:
            best = d[cur][j]
            nxt = j

    tour.append(nxt)
    visited[nxt] = True
    cost += best
    cur = nxt

cost += d[cur][start]
tour.append(start)

print("Tour:", tour)
print("Total distance:", cost)
