b = [' '] * 9
def show():
    for i in range(0, 9, 3):
        print('|'.join(b[i:i+3]))
        if i < 6:
            print("-----")
def win(p):
    lines = [(0,1,2),(3,4,5),(6,7,8),
             (0,3,6),(1,4,7),(2,5,8),
             (0,4,8),(2,4,6)]
    return any(all(b[i] == p for i in line)
               for line in lines)
p = 'X'
while True:
    show()
    r, c = map(int, input(
        f"Player {p}, enter row and column (1-3): ").split())
    i = (r-1)*3 + c-1
    if r not in range(1,4) or c not in range(1,4) or b[i] != ' ':
        print("Invalid move!")
        continue
    b[i] = p
    if win(p):
        show()
        print("Player", p, "wins!")
        break
    if ' ' not in b:
        show()
        print("Match Draw!")
        break
    p = 'O' if p == 'X' else 'X'
